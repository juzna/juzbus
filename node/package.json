{
  "name": "@juzna/juzbus",
  "version": "0.1.0",
  "description": "Node.js bindings for macOS XPC services via Juzbus",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "os": ["darwin"],
  "cpu": ["x64", "arm64"],
  "scripts": {
    "install": "node-gyp rebuild",
    "build": "node-gyp rebuild",
    "preinstall": "bash scripts/build-framework.sh && bash scripts/copy-dylib.sh",
    "test": "node examples/client.js"
  },
  "keywords": [
    "xpc",
    "macos",
    "ipc",
    "native",
    "addon"
  ],
  "author": "juzna",
  "license": "MIT",
  "gypfile": true,
  "dependencies": {
    "node-addon-api": "^8.0.0"
  },
  "devDependencies": {
    "node-gyp": "^10.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
